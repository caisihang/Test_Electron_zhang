!/target/release/
/target/release/*
!/target/release/personal-finance.exe
!/target/release/bundle/
/target/release/bundle/*
!/target/release/bundle/nsis/
/target/release/bundle/nsis/*
!/target/release/bundle/nsis/*.exe
/gen/schemas
